{
  "dataset": {
    "name": "AMLWorld",
    "variant": "HI-Small",
    "transaction_path": "data/raw/amlworld/HI-Small_Trans.csv",
    "pattern_path": "data/raw/amlworld/HI-Small_Patterns.txt",
    "source": "AMLWorld HI-Small",
    "citation": ""
  },
  "standard_format": {
    "dataset_name": "amlworld",
    "output_dir": "data/processed/amlworld"
  },
  "partition": {
    "tag": "ctrl_v2_003",
    "num_banks": 5,
    "min_banks_per_motif": 2,
    "clean_inter_ratio": 0.03,
    "time_mode": "minute",
    "seed": 42,
    "keep_unknown_laundering": true
  },
  "local_encoder": {
    "implementation": "local_encoder",
    "k_hop": 2,
    "num_workers": 1
  },
  "orchestrator": {
    "implementation": "orchestrator",
    "threshold": 0.72,
    "max_group_size": 5,
    "topk_per_sender": 1,
    "topk_per_receiver": 1
  },
  "candidate_builder": {
    "chain_min_len": 3,
    "chain_max_len": 10,
    "cycle_min_len": 2,
    "cycle_max_len": 8,
    "fan_degree_thr": 3
  },
  "evaluation": {
    "hit_definition": "candidate transaction id set overlaps ground-truth motif transaction id set",
    "top_k": [10, 20, 50, 100, 200, 500, 1000]
  },
  "comot": {
    "legacy_node_evidence": {
      "enabled": true,
      "prefix_queries": 300,
      "max_anchor_nodes": 8
    }
  }
}
